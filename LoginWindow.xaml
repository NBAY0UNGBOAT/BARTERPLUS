<Window x:Class="BarterPOS.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Barter+ - Login"
        Height="560"
        Width="860"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">
    <Border CornerRadius="15" Background="White" BorderThickness="1" BorderBrush="#E0E0E0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PrimaryBlueBrush}" CornerRadius="15,0,0,15">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Barter+"
                               FontSize="48"
                               FontWeight="Bold"
                               Foreground="White"
                               TextAlignment="Center"
                               Margin="0,0,0,24"/>
                    <TextBlock Text="Company POS Access"
                               FontSize="14"
                               Foreground="White"
                               Opacity="0.75"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="50">
                <Button HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="20"
                        Foreground="#999999"
                        Padding="5"
                        Cursor="Hand"
                        Click="CloseButton_Click">X</Button>

                <TextBlock Text="Sign In"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#2D5AA6"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Use the account provided by your administrator"
                           FontSize="12"
                           Foreground="#666666"
                           Margin="0,0,0,30"/>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Username"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#333333"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="LoginUsername"
                             FontSize="14"
                             Padding="12,10"
                             Background="White"
                             BorderThickness="1"
                             BorderBrush="#E0E0E0"
                             Text=""
                             Height="40"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Password"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#333333"
                               Margin="0,0,0,5"/>
                    <PasswordBox x:Name="LoginPassword"
                                 FontSize="14"
                                 Padding="12,10"
                                 Background="White"
                                 BorderThickness="1"
                                 BorderBrush="#E0E0E0"
                                 Height="40"/>
                </StackPanel>

                <CheckBox Content="Remember me"
                          FontSize="12"
                          Foreground="#666666"
                          Margin="0,5,0,0"/>

                <Button Content="Sign In"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="White"
                        Background="{StaticResource PrimaryBlueBrush}"
                        Padding="0,12"
                        Height="45"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,10,0,0"
                        Click="SignIn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
