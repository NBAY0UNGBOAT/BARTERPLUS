<Window x:Class="BarterPOS.UserDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Barter+ - User Details"
        Height="720"
        Width="920"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock x:Name="TitleText" Text="User Details" FontSize="26" FontWeight="700" Foreground="#1E40AF"/>
            </StackPanel>

            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="ACCOUNT INFORMATION" FontSize="11" FontWeight="700" Foreground="#64748B" Margin="0,0,0,12"/>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="Username" FontWeight="600" Foreground="#334155"/>
                        <TextBox x:Name="UsernameText" IsReadOnly="True" Background="#F1F5F9" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,12">
                        <TextBlock Text="Employee Name" FontWeight="600" Foreground="#334155"/>
                        <TextBox x:Name="EmployeeNameText" Padding="10,8" MaxLength="80"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="Email" FontWeight="600" Foreground="#334155"/>
                        <TextBox x:Name="EmailText" Padding="10,8" MaxLength="120"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,0,0,12">
                        <TextBlock Text="Contact Number" FontWeight="600" Foreground="#334155"/>
                        <TextBox x:Name="ContactNumberText" Padding="10,8" MaxLength="20"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="Date Created" FontWeight="600" Foreground="#334155"/>
                        <TextBox x:Name="DateCreatedText" IsReadOnly="True" Background="#F1F5F9" Padding="10,8"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="12,0,0,12">
                        <TextBlock Text="Last Login" FontWeight="600" Foreground="#334155"/>
                        <TextBox x:Name="LastLoginText" IsReadOnly="True" Background="#F1F5F9" Padding="10,8"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Account Status" FontWeight="600" Foreground="#334155"/>
                        <TextBox x:Name="StatusText" IsReadOnly="True" Background="#F1F5F9" Padding="10,8"/>
                    </StackPanel>
                    <Button Grid.Row="4" Grid.Column="1" x:Name="SaveInfoButton" Content="Save Account Information" Height="40" Margin="12,18,0,0" Background="#1E40AF" Foreground="White" BorderThickness="0" FontWeight="600" Click="SaveInfo_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="18" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="PERMISSION MANAGEMENT" FontSize="11" FontWeight="700" Foreground="#64748B" Margin="0,0,0,12"/>
                        <TextBlock Text="Current Role" FontWeight="600" Foreground="#334155"/>
                        <ComboBox x:Name="RoleComboBox" Padding="10,8" Margin="0,0,0,12">
                            <ComboBoxItem Content="Admin"/>
                            <ComboBoxItem Content="Employee"/>
                        </ComboBox>
                        <Button Content="Change Role" Height="38" Background="#059669" Foreground="White" BorderThickness="0" FontWeight="600" Margin="0,0,0,10" Click="ChangeRole_Click"/>
                        <Button x:Name="ToggleStatusButton" Content="Disable Account" Height="38" Background="#EA580C" Foreground="White" BorderThickness="0" FontWeight="600" Click="ToggleStatus_Click"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="18" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="RESET PASSWORD" FontSize="11" FontWeight="700" Foreground="#64748B" Margin="0,0,0,12"/>
                        <TextBlock Text="New Password" FontWeight="600" Foreground="#334155"/>
                        <PasswordBox x:Name="NewPasswordBox" Padding="10,8" Margin="0,0,0,12" MaxLength="64"/>
                        <Button Content="Reset Password" Height="38" Background="#334155" Foreground="White" BorderThickness="0" FontWeight="600" Click="ResetPassword_Click"/>
                        <Button x:Name="DeleteAccountButton" Content="Delete Account" Height="38" Margin="0,10,0,0" Background="#B91C1C" Foreground="White" BorderThickness="0" FontWeight="600" Click="DeleteAccount_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="18" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="ACTIVITY LOG" FontSize="11" FontWeight="700" Foreground="#64748B" Margin="0,0,0,12"/>
                        <DataGrid x:Name="ActivityGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" MaxHeight="180">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding TimestampDisplay}" Width="170"/>
                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="18" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="ACCOUNT STATUS" FontSize="11" FontWeight="700" Foreground="#64748B" Margin="0,0,0,12"/>
                        <TextBlock Text="Current Role" Foreground="#64748B"/>
                        <TextBlock Text="{Binding ElementName=RoleComboBox, Path=Text}" FontSize="20" FontWeight="700" Foreground="#1E293B" Margin="0,0,0,10"/>
                        <TextBlock Text="Current Status" Foreground="#64748B"/>
                        <TextBlock Text="{Binding ElementName=StatusText, Path=Text}" FontSize="20" FontWeight="700" Foreground="#1E293B" Margin="0,0,0,10"/>
                        <TextBlock Text="Last Login" Foreground="#64748B"/>
                        <TextBlock Text="{Binding ElementName=LastLoginText, Path=Text}" FontSize="16" FontWeight="600" Foreground="#1E293B"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
