<Window x:Class="BarterPOS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:BarterPOS"
        Title="Barter+ POS"
        Height="750"
        Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        WindowState="Maximized">
    <Window.Resources>
        <ResourceDictionary>
            <local:CurrencyConverter x:Key="CurrencyConverter"/>

            <Color x:Key="PrimaryBlue">#1E40AF</Color>
            <Color x:Key="AccentGreen">#059669</Color>
            <Color x:Key="AccentOrange">#EA580C</Color>
            <Color x:Key="LightGray">#F8FAFC</Color>
            <Color x:Key="BorderGray">#E2E8F0</Color>
            <Color x:Key="TextDark">#1E293B</Color>
            <Color x:Key="TextMuted">#64748B</Color>

            <SolidColorBrush x:Key="PrimaryBlueBrush" Color="{StaticResource PrimaryBlue}"/>
            <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreen}"/>
            <SolidColorBrush x:Key="AccentOrangeBrush" Color="{StaticResource AccentOrange}"/>
            <SolidColorBrush x:Key="LightGrayBrush" Color="{StaticResource LightGray}"/>
            <SolidColorBrush x:Key="BorderGrayBrush" Color="{StaticResource BorderGray}"/>
            <SolidColorBrush x:Key="TextDarkBrush" Color="{StaticResource TextDark}"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>

            <DropShadowEffect x:Key="ShadowEffect" BlurRadius="12" ShadowDepth="3" Opacity="0.08" Color="#000000"/>
            <DropShadowEffect x:Key="ShadowEffectLight" BlurRadius="8" ShadowDepth="2" Opacity="0.05" Color="#000000"/>

            <sys:Double x:Key="FontSize.Small">11</sys:Double>
            <sys:Double x:Key="FontSize.Normal">12</sys:Double>
            <sys:Double x:Key="FontSize.Medium">13</sys:Double>
            <sys:Double x:Key="FontSize.Large">15</sys:Double>
            <sys:Double x:Key="FontSize.XLarge">28</sys:Double>
            <sys:Double x:Key="FontSize.Title">32</sys:Double>

            <Style x:Key="FunctionButtonStyle" TargetType="Button">
                <Setter Property="FontSize" Value="{StaticResource FontSize.Medium}"/>
                <Setter Property="FontWeight" Value="600"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.9"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PrimaryBlueBrush}" Padding="24,16" Effect="{StaticResource ShadowEffect}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="BARTER+ POS" FontSize="{StaticResource FontSize.Title}" FontWeight="700" Foreground="White"/>
                    <TextBlock Foreground="#BFDBFE" FontSize="{StaticResource FontSize.Small}" Margin="0,4,0,0">
                        <Run Text="{Binding CashierName, Mode=OneWay}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding CashierRole, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" Margin="24,0,24,0">
                    <TextBlock Foreground="White" FontSize="{StaticResource FontSize.Small}" FontWeight="500">
                        <Run Text="Trans. ID: "/><Run Text="{Binding CurrentSale.TransactionId}"/>
                    </TextBlock>
                    <TextBlock Foreground="White" FontSize="{StaticResource FontSize.Small}" FontWeight="500">
                        <Run Text="Terminal: "/><Run Text="{Binding CurrentSale.TerminalId}"/>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding CurrentDateTime}"
                           Foreground="White"
                           FontSize="{StaticResource FontSize.Small}"
                           FontWeight="500"
                           VerticalAlignment="Center"
                           MinWidth="220"
                           Margin="24,0,24,0"/>

                <Button Grid.Column="3"
                        Background="#DBEAFE"
                        Foreground="{StaticResource PrimaryBlueBrush}"
                        Padding="12,6"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,12,0"
                        Click="SyncOffline_Click">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{Binding SyncStatusText, Mode=OneWay}" FontSize="{StaticResource FontSize.Small}" FontWeight="700" TextAlignment="Center"/>
                        <TextBlock FontSize="10" TextAlignment="Center">
                            <Run Text="Pending: "/><Run Text="{Binding PendingSyncCount, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <Button Grid.Column="4"
                        x:Name="ManageUsersButton"
                        Content="Manage Users"
                        FontSize="{StaticResource FontSize.Normal}"
                        FontWeight="600"
                        Foreground="White"
                        Background="{StaticResource AccentGreenBrush}"
                        Padding="12,6"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,12,0"
                        Visibility="Collapsed"
                        Click="ManageUsers_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="5"
                        Content="Logout"
                        FontSize="{StaticResource FontSize.Normal}"
                        FontWeight="600"
                        Foreground="White"
                        Background="{StaticResource AccentOrangeBrush}"
                        Padding="12,6"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Logout_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" CornerRadius="12" Padding="24" Effect="{StaticResource ShadowEffect}" Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,0,18">
                            <TextBlock Text="AMOUNT DUE" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSize.Small}" FontWeight="600" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding AmountDue, Converter={StaticResource CurrencyConverter}}" FontSize="36" FontWeight="700" Foreground="{StaticResource PrimaryBlueBrush}"/>
                        </StackPanel>

                        <Border Background="{StaticResource BorderGrayBrush}" Height="1" Margin="0,12,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Vertical">
                                <TextBlock Text="TOTAL ITEMS" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSize.Small}" FontWeight="600" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding TotalItems}" FontSize="22" FontWeight="700" Foreground="{StaticResource TextDarkBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <TextBlock Text="TOTAL AMOUNT" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSize.Small}" FontWeight="600" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="700" Foreground="{StaticResource TextDarkBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="12" Padding="24" Effect="{StaticResource ShadowEffect}">
                    <StackPanel>
                        <TextBlock Text="DISCOUNTS" Foreground="{StaticResource TextMutedBrush}" FontSize="{StaticResource FontSize.Small}" FontWeight="600" Margin="0,0,0,16"/>

                        <CheckBox Content="PWD (20% off)"
                                  IsChecked="{Binding IsPwdDiscount}"
                                  FontSize="{StaticResource FontSize.Medium}"
                                  Foreground="{StaticResource TextDarkBrush}"
                                  Margin="0,0,0,10"/>

                        <CheckBox Content="Senior (20% off)"
                                  IsChecked="{Binding IsSeniorDiscount}"
                                  FontSize="{StaticResource FontSize.Medium}"
                                  Foreground="{StaticResource TextDarkBrush}"
                                  Margin="0,0,0,16"/>

                        <TextBlock Text="Enter Amount"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="{StaticResource FontSize.Small}"
                                   FontWeight="600"
                                   Margin="0,0,0,6"/>
                        <TextBox Text="{Binding DeductionInput, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="{StaticResource FontSize.Large}"
                                 Padding="10,8"
                                 BorderBrush="{StaticResource BorderGrayBrush}"/>
                        <TextBlock Text="Fixed amount to subtract (e.g. gift card)"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="{StaticResource FontSize.Small}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="12" Padding="24" Effect="{StaticResource ShadowEffect}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="CASH DRAWER"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="{StaticResource FontSize.Small}"
                                   FontWeight="600"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding CashDrawerBalance, Converter={StaticResource CurrencyConverter}, Mode=OneWay}"
                                   FontSize="28"
                                   FontWeight="700"
                                   Foreground="{StaticResource AccentGreenBrush}"
                                   Margin="0,0,0,6"/>

                        <TextBlock Text="{Binding CashDrawerLastActivity, Mode=OneWay}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="{StaticResource FontSize.Small}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="Cash In"
                                    Background="{StaticResource AccentGreenBrush}"
                                    Style="{StaticResource FunctionButtonStyle}"
                                    Margin="0,0,6,0"
                                    Click="CashIn_Click"/>

                            <Button Grid.Column="1"
                                    Content="Cash Out"
                                    Background="{StaticResource AccentOrangeBrush}"
                                    Style="{StaticResource FunctionButtonStyle}"
                                    Margin="6,0,0,0"
                                    Click="CashOut_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Column="1" Margin="24,0,0,0">
                <Border Background="White" CornerRadius="12" Padding="18" Effect="{StaticResource ShadowEffectLight}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SCAN" FontSize="26" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1"
                                 FontSize="{StaticResource FontSize.Large}"
                                 Padding="12"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TextDarkBrush}"
                                 Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Border>

                <Border Background="White" CornerRadius="12" Effect="{StaticResource ShadowEffect}" Padding="0">
                    <DataGrid ItemsSource="{Binding LineItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="White"
                              Margin="16">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="QTY" Binding="{Binding Quantity}" Width="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="ItemNum" Binding="{Binding Code}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="PRODUCT" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="PRICE" Binding="{Binding Price, Converter={StaticResource CurrencyConverter}}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding Subtotal, Converter={StaticResource CurrencyConverter}}" Width="120" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="#1A1A2E" Padding="8">
            <UniformGrid Columns="6" Margin="8">
                <Button Background="{StaticResource PrimaryBlueBrush}" Style="{StaticResource FunctionButtonStyle}" Margin="3">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="F1" FontSize="11" Foreground="White" TextAlignment="Center" Margin="0,0,0,3" FontWeight="700"/>
                        <TextBlock Text="Item Search" FontSize="10" Foreground="White" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Background="{StaticResource PrimaryBlueBrush}" Style="{StaticResource FunctionButtonStyle}" Margin="3">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="F2" FontSize="11" Foreground="White" TextAlignment="Center" Margin="0,0,0,3" FontWeight="700"/>
                        <TextBlock Text="Void Line" FontSize="10" Foreground="White" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Background="{StaticResource AccentGreenBrush}" Style="{StaticResource FunctionButtonStyle}" Margin="3">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="F3" FontSize="11" Foreground="White" TextAlignment="Center" Margin="0,0,0,3" FontWeight="700"/>
                        <TextBlock Text="Add Customer" FontSize="10" Foreground="White" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Background="{StaticResource AccentGreenBrush}" Style="{StaticResource FunctionButtonStyle}" Margin="3" Click="ClearSale_Click">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="F4" FontSize="11" Foreground="White" TextAlignment="Center" Margin="0,0,0,3" FontWeight="700"/>
                        <TextBlock Text="Clear Sale" FontSize="10" Foreground="White" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Background="{StaticResource AccentOrangeBrush}" Style="{StaticResource FunctionButtonStyle}" Margin="3" Click="CashPayment_Click">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="F5" FontSize="11" Foreground="White" TextAlignment="Center" Margin="0,0,0,3" FontWeight="700"/>
                        <TextBlock Text="Cash" FontSize="10" Foreground="White" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Background="{StaticResource AccentOrangeBrush}" Style="{StaticResource FunctionButtonStyle}" Margin="3" Click="CardPayment_Click">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="F6" FontSize="11" Foreground="White" TextAlignment="Center" Margin="0,0,0,3" FontWeight="700"/>
                        <TextBlock Text="Card" FontSize="10" Foreground="White" TextAlignment="Center"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Border>
    </Grid>
</Window>
