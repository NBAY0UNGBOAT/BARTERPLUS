<Window x:Class="BarterPOS.CashDrawerMovementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cash Drawer"
        Height="390"
        Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">
    <Border Background="White" CornerRadius="10" Padding="24" Margin="12" BorderBrush="#E2E8F0" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="MovementTitle"
                       Text="Cash Movement"
                       FontSize="22"
                       FontWeight="700"
                       Foreground="#1E293B"
                       Margin="0,0,0,18"/>

            <TextBlock Grid.Row="1"
                       Text="Amount"
                       FontSize="12"
                       FontWeight="600"
                       Foreground="#64748B"
                       Margin="0,0,0,6"/>
            <TextBox Grid.Row="2"
                     x:Name="AmountText"
                     FontSize="16"
                     Padding="10,8"
                     BorderBrush="#E2E8F0"
                     Margin="0,0,0,12"/>

            <TextBlock Grid.Row="3"
                       Text="Note"
                       FontSize="12"
                       FontWeight="600"
                       Foreground="#64748B"
                       Margin="0,0,0,6"/>
            <TextBox Grid.Row="4"
                     x:Name="NoteText"
                     FontSize="14"
                     Padding="10,8"
                     BorderBrush="#E2E8F0"
                     Height="72"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,54"/>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom">
                <Button Content="Cancel"
                        MinWidth="90"
                        Padding="12,8"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button Content="Save"
                        MinWidth="90"
                        Padding="12,8"
                        Background="#059669"
                        Foreground="White"
                        BorderThickness="0"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
