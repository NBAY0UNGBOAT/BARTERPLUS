<Window x:Class="BarterPOS.RefundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Process Refund"
        Height="450"
        Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Text="Select items to refund"
            FontSize="18"
            FontWeight="Bold"
            Margin="0,0,0,15"/>

        <DataGrid x:Name="RefundGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column">

            <DataGrid.Columns>

                <DataGridCheckBoxColumn
                    Header="Refund"
                    Binding="{Binding IsSelected}"
                    Width="70"/>

                <DataGridTextColumn
                    Header="Product"
                    Binding="{Binding SaleItem.Name}"
                    Width="*"/>

                <DataGridTextColumn
                    Header="Qty"
                    Binding="{Binding SaleItem.Quantity}"
                    Width="70"/>

                <DataGridTextColumn
                    Header="Price"
                    Binding="{Binding SaleItem.UnitPrice}"
                    Width="90"/>

            </DataGrid.Columns>

        </DataGrid>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,15,0,0">

            <Button
                Width="100"
                Margin="0,0,10,0"
                Content="Cancel"
                Click="Cancel_Click"/>

            <Button
                Width="130"
                Content="Process Refund"
                Click="Refund_Click"/>

        </StackPanel>

    </Grid>

</Window>