<Window x:Class="BarterPOS.TransactionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transaction History"
        Height="500"
        Width="900"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Transaction History"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <DataGrid Grid.Row="1"
                  x:Name="TransactionsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Transaction ID" Binding="{Binding TransactionId}"/>
                <DataGridTextColumn Header="Completed" Binding="{Binding CompletedAt}"/>
                <DataGridTextColumn Header="Cashier" Binding="{Binding Cashier}"/>
                <DataGridTextColumn Header="Payment" Binding="{Binding PaymentMethod}"/>
                <DataGridTextColumn Header="Total" Binding="{Binding NetAmount}"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button x:Name="VoidButton"
                    Content="Void Transaction"
                    Width="140"
                    Margin="0,0,10,0"
                    Click="VoidTransaction_Click"/>
            <Button x:Name="RefundButton"
                    Content="Process Refund"
                    Width="140"/>
        </StackPanel>
    </Grid>
</Window>