<Window x:Class="BarterPOS.CreateUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Barter+ - Create User"
        Height="560"
        Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Create User" FontSize="26" FontWeight="700" Foreground="#1E40AF"/>
            <TextBlock Text="Add a staff account and assign its starting permission." FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                    <TextBlock Text="Employee ID" FontWeight="600" Foreground="#334155"/>
                    <TextBox x:Name="EmployeeIdText" Padding="10,8"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,12">
                    <TextBlock Text="Employee Name" FontWeight="600" Foreground="#334155"/>
                    <TextBox x:Name="FullNameText" Padding="10,8"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,12">
                    <TextBlock Text="Email" FontWeight="600" Foreground="#334155"/>
                    <TextBox x:Name="EmailText" Padding="10,8"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,12">
                    <TextBlock Text="Contact Number" FontWeight="600" Foreground="#334155"/>
                    <TextBox x:Name="ContactNumberText" Padding="10,8"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,12">
                    <TextBlock Text="Username" FontWeight="600" Foreground="#334155"/>
                    <TextBox x:Name="UsernameText" Padding="10,8"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,12">
                    <TextBlock Text="Temporary Password" FontWeight="600" Foreground="#334155"/>
                    <PasswordBox x:Name="PasswordText" Padding="10,8"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
                    <TextBlock Text="Permission" FontWeight="600" Foreground="#334155"/>
                    <ComboBox x:Name="RoleComboBox" Padding="10,8" SelectedIndex="2">
                        <ComboBoxItem Content="Admin"/>
                        <ComboBoxItem Content="Manager"/>
                        <ComboBoxItem Content="Cashier"/>
                        <ComboBoxItem Content="Employee"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="The account is active immediately after creation." FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Cancel" Width="100" Height="38" Margin="0,0,10,0" Background="#E2E8F0" Foreground="#1E293B" BorderThickness="0" FontWeight="600" Cursor="Hand" Click="Cancel_Click"/>
            <Button Grid.Column="2" Content="Create User" Width="120" Height="38" Background="#059669" Foreground="White" BorderThickness="0" FontWeight="600" Cursor="Hand" Click="Create_Click"/>
        </Grid>
    </Grid>
</Window>
