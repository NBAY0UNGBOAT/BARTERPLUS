<Window x:Class="BarterPOS.AuditTrailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audit Trail"
        Height="760"
        Width="1320"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Audit Trail" FontSize="28" FontWeight="700" Foreground="#1E293B"/>
            <TextBlock Text="System activity across sales, refunds, cash drawer movements, reconciliations, and admin actions." FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16">
            <DataGrid x:Name="AuditGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="White"
                      RowHeight="42"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Timestamp" Binding="{Binding TimestampDisplay}" Width="170"/>
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="180"/>
                    <DataGridTextColumn Header="Entity" Binding="{Binding EntityType}" Width="130"/>
                    <DataGridTextColumn Header="Entity ID" Binding="{Binding EntityId}" Width="110"/>
                    <DataGridTextColumn Header="Actor" Binding="{Binding Actor}" Width="150"/>
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="110"/>
                    <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Refresh" Width="110" Margin="0,0,10,0" Click="Refresh_Click"/>
            <Button Content="Close" Width="110" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>