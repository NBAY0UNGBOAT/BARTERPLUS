<Window x:Class="BarterPOS.EndOfDayReconciliationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="End-of-Day Sales Reconciliation"
        Height="720"
        Width="820"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="End-of-Day Sales Reconciliation"
                           FontSize="22"
                           FontWeight="700"
                           Foreground="#1E293B"/>
                <TextBlock x:Name="AlreadyReconciledText"
                           Text="A reconciliation for this date has already been saved. Saving again will overwrite it."
                           FontSize="12"
                           Foreground="#B45309"
                           Margin="0,4,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Business Date"
                           FontSize="12"
                           FontWeight="600"
                           Foreground="#64748B"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <DatePicker x:Name="BusinessDatePicker"
                            Width="140"
                            SelectedDateChanged="BusinessDatePicker_SelectedDateChanged"/>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Sales summary -->
                <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,14"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Sales Summary" FontSize="15" FontWeight="700" Foreground="#1E293B" Margin="0,0,0,10"/>

                        <UniformGrid Columns="4" Rows="2">
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Transactions" FontSize="12" Foreground="#64748B"/>
                                <TextBlock x:Name="TransactionCountText" Text="0" FontSize="18" FontWeight="600" Foreground="#1E293B"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Voided" FontSize="12" Foreground="#64748B"/>
                                <TextBlock x:Name="VoidedCountText" Text="0" FontSize="18" FontWeight="600" Foreground="#1E293B"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Refunded" FontSize="12" Foreground="#64748B"/>
                                <TextBlock x:Name="RefundedCountText" Text="0" FontSize="18" FontWeight="600" Foreground="#1E293B"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Gross Sales" FontSize="12" Foreground="#64748B"/>
                                <TextBlock x:Name="GrossSalesText" Text="₱0.00" FontSize="18" FontWeight="600" Foreground="#1E293B"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Discounts" FontSize="12" Foreground="#64748B"/>
                                <TextBlock x:Name="DiscountsText" Text="₱0.00" FontSize="18" FontWeight="600" Foreground="#1E293B"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Net Sales" FontSize="12" Foreground="#64748B"/>
                                <TextBlock x:Name="NetSalesText" Text="₱0.00" FontSize="18" FontWeight="700" Foreground="#059669"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Payment method breakdown -->
                <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,14"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Sales by Payment Method" FontSize="15" FontWeight="700" Foreground="#1E293B" Margin="0,0,0,10"/>
                        <DataGrid x:Name="PaymentMethodGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  MaxHeight="180"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Payment Method" Binding="{Binding PaymentMethod}" Width="*"/>
                                <DataGridTextColumn Header="Transactions" Binding="{Binding TransactionCount}" Width="120"/>
                                <DataGridTextColumn Header="Gross Amount" Binding="{Binding GrossAmount, StringFormat={}{0:C}}" Width="140"/>
                                <DataGridTextColumn Header="Net Amount" Binding="{Binding NetAmount, StringFormat={}{0:C}}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Cash reconciliation -->
                <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,14"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Cash Drawer Reconciliation" FontSize="15" FontWeight="700" Foreground="#1E293B" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cash Sales" FontSize="12" Foreground="#64748B"/>
                                <TextBlock x:Name="CashSalesText" Text="₱0.00" FontSize="15" FontWeight="600" Foreground="#1E293B"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Cash In" FontSize="12" Foreground="#64748B"/>
                                <TextBlock x:Name="CashInText" Text="₱0.00" FontSize="15" FontWeight="600" Foreground="#1E293B"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cash Out" FontSize="12" Foreground="#64748B"/>
                                <TextBlock x:Name="CashOutText" Text="₱0.00" FontSize="15" FontWeight="600" Foreground="#1E293B"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Cash Refunds" FontSize="12" Foreground="#64748B"/>
                                <TextBlock x:Name="CashRefundsText" Text="₱0.00" FontSize="15" FontWeight="600" Foreground="#1E293B"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Expected Cash" FontSize="12" FontWeight="600" Foreground="#64748B" Margin="0,0,0,6"/>
                                <TextBlock x:Name="ExpectedCashText" Text="₱0.00" FontSize="20" FontWeight="700" Foreground="#1E293B"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="Counted Cash" FontSize="12" FontWeight="600" Foreground="#64748B" Margin="0,0,0,6"/>
                                <TextBox x:Name="CountedCashText"
                                         FontSize="16"
                                         Padding="10,8"
                                         BorderBrush="#E2E8F0"
                                         TextChanged="CountedCashText_TextChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Variance" FontSize="12" FontWeight="600" Foreground="#64748B" Margin="0,0,0,6"/>
                                <TextBlock x:Name="VarianceText" Text="₱0.00 (Balanced)" FontSize="20" FontWeight="700" Foreground="#059669"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Notes" FontSize="12" FontWeight="600" Foreground="#64748B" Margin="0,14,0,6"/>
                        <TextBox x:Name="NotesText"
                                 FontSize="13"
                                 Padding="10,8"
                                 BorderBrush="#E2E8F0"
                                 AcceptsReturn="True"
                                 Height="60"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Close"
                    MinWidth="100"
                    Padding="12,8"
                    Margin="0,0,8,0"
                    Click="Close_Click"/>
            <Button x:Name="SaveButton"
                    Content="Save Reconciliation"
                    MinWidth="160"
                    Padding="12,8"
                    Background="#059669"
                    Foreground="White"
                    BorderThickness="0"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
