<Window x:Class="BarterPOS.CreateLoyaltyCustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Loyalty Card"
        Height="330"
        Width="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Create Loyalty Card"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#1E293B"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="2"
                   Text="Customer Name"
                   Foreground="#475569"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6"/>

        <TextBox x:Name="CustomerNameTextBox"
                 Grid.Row="3"
                 Padding="10,8"
                 FontSize="14"
                 MaxLength="80"
                 Margin="0,0,0,14"/>

        <TextBlock Grid.Row="4"
                   Text="Customer Type"
                   Foreground="#475569"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6"/>

        <ComboBox x:Name="CustomerTypeComboBox"
                  Grid.Row="5"
                  SelectedIndex="0"
                  Padding="8"
                  FontSize="14"
                  VerticalContentAlignment="Center">
            <ComboBoxItem Content="REGULAR"/>
            <ComboBoxItem Content="PWD"/>
            <ComboBoxItem Content="SENIOR"/>
        </ComboBox>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Cancel" Width="100" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Create Card" Width="120" Click="Create_Click"/>
        </StackPanel>
    </Grid>
</Window>
